{
  "name": "quran-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "server": "json-server --watch db.json --port 3000"
